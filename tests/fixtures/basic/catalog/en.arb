{
  "@@locale": "en",
  "common.cancel": "Cancel",
  "@common.cancel": {
    "description": "Button that closes a dialog without saving."
  },
  "home.section.continueWatching": "Continue Watching",
  "@home.section.continueWatching": {
    "description": "Home row title -- items the profile started and has not finished.",
    "x-maxLength": 24
  },
  "signIn.body": "Sign in to {server} as {account}.",
  "@signIn.body": {
    "description": "Sign-in screen body. {server} is the server name; {account} is the user name.",
    "placeholders": {
      "server": {
        "type": "String"
      },
      "account": {
        "type": "String"
      }
    }
  },
  "catalog.seasons": "{count, plural, one {# Season} other {# Seasons}}",
  "@catalog.seasons": {
    "description": "Number of seasons on a series page.",
    "placeholders": {
      "count": {
        "type": "int"
      }
    }
  },
  "companion.limit": "{count, plural, one {{name} can choose # item} other {{name} can choose # items}}",
  "@companion.limit": {
    "description": "How many items a profile may pick. {name} is the profile name; {count} the limit.",
    "placeholders": {
      "name": {
        "type": "String"
      },
      "count": {
        "type": "int"
      }
    }
  },
  "player.rate": "{rate}× speed, 100% volume",
  "@player.rate": {
    "description": "Player status line. {rate} is the playback rate as a number.",
    "placeholders": {
      "rate": {
        "type": "double"
      }
    }
  },
  "player.volumeFull": "Volume 100%",
  "@player.volumeFull": {
    "description": "Shown when the volume is at its maximum."
  },
  "setup.headline": "Enter your\nserver address",
  "@setup.headline": {
    "description": "Setup headline, two lines.",
    "x-platforms": [
      "roku",
      "android"
    ]
  },
  "text.escapes": "@home \"quoted\" Tom’s 1 < 2 > 0 & co.  two spaces ",
  "@text.escapes": {
    "description": "Escaping test: leading @, quotes, typographic apostrophe, markup characters, repeated and trailing spaces.",
    "x-platforms": [
      "android",
      "apple",
      "roku"
    ]
  },
  "catalog.extra.behind_the_scenes": "Behind the Scenes",
  "@catalog.extra.behind_the_scenes": {
    "description": "Extra type label; the last segment is the server's extra type."
  },
  "web.greeting": "{gender, select, female {She} male {He} other {They}} invited you to <b>{party}</b>",
  "@web.greeting": {
    "description": "Watch Together invitation (web only).",
    "placeholders": {
      "gender": {
        "type": "String"
      },
      "party": {
        "type": "String"
      }
    },
    "x-platforms": [
      "web"
    ]
  },
  "player.progress": "{count, plural, one {# of {total} episode watched} other {# of {total} episodes watched}}",
  "@player.progress": {
    "description": "Series progress. {count}: episodes watched; {total}: episodes in the series.",
    "placeholders": {
      "count": {
        "type": "int"
      },
      "total": {
        "type": "int"
      }
    }
  },
  "player.muted": "Muted",
  "@player.muted": {
    "description": "Shown when the volume is at zero."
  }
}
